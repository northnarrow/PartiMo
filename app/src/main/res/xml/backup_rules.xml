<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8–11: nessun dato nel backup automatico (l'app conserva solo una cache ricostruibile). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" />
</full-backup-content>
